# Copy to .env and adjust. Never commit .env (it may contain credentials).

# ---------------------------------------------------------------- MongoDB
# Local server only. Non-local hosts are rejected by the application.
MONGODB_URI=mongodb://127.0.0.1:27017/
MONGODB_DB=imsdb_local
# Optional authentication (leave blank when access control is disabled).
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=admin
MONGODB_TIMEOUT_MS=5000
# Folder containing mongodump/mongorestore if they are not on PATH, e.g.
# Windows: D:\tools\mongodb\database-tools-100.20.1\bin
# Linux/macOS: /usr/local/bin
MONGODB_TOOLS_DIR=D:/tools/mongodb/database-tools-100.20.1/bin

# Optional: used only by scripts/local_mongodb.py for portable (non-service) installs.
MONGOD_PATH=D:/tools/mongodb/server-9.0.4/bin/mongod.exe
MONGOD_CONFIG=D:/tools/mongodb/mongod.cfg

# ---------------------------------------------------------------- Storage
# Relative paths are resolved against the project root.
IMSDB_DATA_DIR=data
IMSDB_LOG_DIR=logs
IMSDB_RAW_GZIP=false

# ---------------------------------------------------------------- Logging
IMSDB_LOG_LEVEL=INFO

# ---------------------------------------------------------------- Crawling (be polite)
IMSDB_BASE_URL=https://imsdb.com/
# Identify the crawler honestly. You may append a contact URL or address you control.
IMSDB_USER_AGENT=imsdb-local-research/1.0 (educational research archive; local use)
# Minimum seconds between requests to the same host (floor: 1.0).
IMSDB_MIN_REQUEST_INTERVAL=5.0
IMSDB_CONCURRENCY=2
IMSDB_REQUEST_TIMEOUT=30
IMSDB_CONNECT_TIMEOUT=10
# HTTP-level retries per request (exponential backoff with jitter).
IMSDB_MAX_RETRIES=4
IMSDB_BACKOFF_BASE=2.0
IMSDB_BACKOFF_MAX=120
# Retry-After values above this are not waited out inline; the URL is rescheduled instead.
IMSDB_MAX_RETRY_AFTER=600
# Queue-level attempts before a URL is marked failed.
IMSDB_MAX_QUEUE_ATTEMPTS=5
IMSDB_LEASE_SECONDS=1800
IMSDB_MAX_RESPONSE_BYTES=20000000
