# Python caches (regenerated automatically)
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# Everything else in the project folder is committed: code, models, virtual environment, .env, logs and the
# collected archive (data/raw, data/backups, data/exports).
# THIS REPOSITORY MUST STAY PRIVATE: data/ contains copyrighted screenplays that may not be redistributed.

# Files over GitHub's 100 MB limit are committed as pieces below 95 MiB and rebuilt automatically:
#  - models: data/models/parts/*.partNNN, joined (SHA-256-checked) on first use
#  - backups: <file>.partNNN next to the file (python -m src.main backup --split DIR), joined by
#    backup --verify / restore. List each split original here.
data/models/*.gguf
data/models/*.part
data/models/*.assembling
data/backups/backup-20261123T170813Z/mongodb.archive.gz
data/backups/backup-20261124T122400Z/mongodb.archive.gz
data/backups/*/*.joining
data/index/*

# Optional CUDA build (510 MB; installed with: python scripts/setup.py --chatbot --gpu-backend cuda)
runtime/gpu/cuda/

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
