# Python caches (regenerated automatically)
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# Everything else in the project folder is committed (models, virtual environment, .env, logs, reports, runtime),
# EXCEPT the collected screenplay content: it is copyrighted by its owners and must not be redistributed.
data/raw/*
data/processed/*
data/backups/*
data/exports/export-*/
!data/**/.gitkeep

# Models are committed as pieces below GitHub's 100 MB limit (data/models/parts) and reassembled on first use;
# the assembled files and download/assembly leftovers are not committed.
data/models/*.gguf
data/models/*.part
data/models/*.assembling
data/index/*

# Optional CUDA build (510 MB; installed with: python scripts/setup.py --chatbot --gpu-backend cuda)
runtime/gpu/cuda/

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
